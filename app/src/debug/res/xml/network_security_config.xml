<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY. Overrides the strict main-source version.
     targetSdk 35 blocks cleartext by default, so core-api on the developer's machine is
     unreachable over http without this — and SyncClient turns the resulting IOException into
     silence, which looks exactly like "nothing to sync". That cost a full bring-up cycle to
     diagnose; it is called out in the plan's Task 8 so it cannot cost another.

     Scoped to the two loopback hosts only: 10.0.2.2 is how the Android emulator reaches the
     host machine, localhost is for a device on adb reverse. Everything else stays HTTPS-only
     even in debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
